# Variáveis lidas pelo docker compose (interpolação no docker-compose.yml).
# Copie para infra/.env — NÃO confundir com backend/.env, que é o ambiente
# de runtime do container backend.

# Porta em que o frontend (nginx) é exposto no host
PORT=80

# Supabase Storage — viram build args do frontend (VITE_*).
# O Vite injeta essas variáveis no bundle em BUILD TIME, então elas precisam
# estar aqui antes do `docker compose build`, não só no backend/.env.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
