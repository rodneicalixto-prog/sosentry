# Banco de Dados (Supabase)
# Pooler (pgbouncer) para queries — use %40 no lugar de @ na senha
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta para migrations
DIRECT_URL="postgresql://postgres:SUA_SENHA@db.SEU_PROJECT_REF.supabase.co:5432/postgres"

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="troque-por-secret-aleatorio-seguro"
JWT_REFRESH_SECRET="troque-por-outro-secret-aleatorio-seguro"

# Servidor
PORT=3001
NODE_ENV=development

# CORS — URL onde o frontend está hospedado
FRONTEND_URL="http://localhost:5173"

# Evolution API (WhatsApp)
EVOLUTION_API_URL="https://evogo.sosbot.online"
EVOLUTION_API_KEY="sua-api-key-da-evolution"
EVOLUTION_INSTANCE="portaria"

# Número do responsável que recebe notificações (formato: 5511999999999)
WHATSAPP_RESPONSAVEL=""

# Senha do superadmin criado pelo seed
SEED_SUPERADMIN_SENHA="Trocar@123"
