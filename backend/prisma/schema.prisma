generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  superadmin
  admin
  supervisor
  operador
}
enum StatusRegistro {
  na_fila
  na_empresa
  saiu
  cancelado
}
enum StatusOcorrencia {
  aberta
  em_analise
  resolvida
  encaminhada
  arquivada
}
enum TipoPortaria {
  transportes
  pedestres
}
model User {
  id           String    @id @default(uuid())
  nome         String
  login        String    @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(operador)
  turno        String?
  setor        String?
  recebeWhatsapp Boolean @default(false) @map("recebe_whatsapp")
  telefone          String?
  resetToken        String?   @unique @map("reset_token")
  resetTokenExpiry  DateTime? @map("reset_token_expiry")
  trocaSenhaObrigatoria Boolean @default(false) @map("troca_senha_obrigatoria")
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by")
  sessions     Session[]
  registrosEntrada Registro[] @relation("OperadorEntrada")
  registrosSaida   Registro[] @relation("OperadorSaida")
  auditLogs    AuditLog[]
  ocorrencias  Ocorrencia[]
  videosUniversidade VideoUniversidade[]
  apiKeys               ApiKey[]
  agendamentosCriados   Agendamento[] @relation("AgendamentoCriador")
  agendamentosAprovados Agendamento[] @relation("AgendamentoAprovador")
  @@map("users")
}
model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  ip           String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}
model Portaria {
  id        String       @id @default(uuid())
  numero    Int          @unique
  nome      String
  tipo      TipoPortaria
  ativo     Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  registros    Registro[]
  agendamentos Agendamento[]
  @@map("portarias")
}
model Registro {
  id                String         @id @default(uuid())
  protocolo         String         @unique
  portariaId        String         @map("portaria_id")
  operadorEntradaId String         @map("operador_entrada_id")
  operadorSaidaId   String?        @map("operador_saida_id")
  nomeMotorista     String         @map("nome_motorista")
  cpfMotorista      String         @map("cpf_motorista")
  telefoneMotorista String?        @map("telefone_motorista")
  placa             String
  tipoVeiculo       String         @map("tipo_veiculo")
  empresa           String?
  notaFiscal        String?        @map("nota_fiscal")
  tipoOperacao      String         @map("tipo_operacao")
  tipoMaterial      String?        @map("tipo_material")
  tipoEmbalagem     String?        @map("tipo_embalagem")
  quantidade        Int?
  obsMaterial       String?        @map("obs_material")
  obsGeral          String?        @map("obs_geral")
  temAjudante       Boolean        @default(false) @map("tem_ajudante")
  ajudanteNome      String?        @map("ajudante_nome")
  ajudanteCpf       String?        @map("ajudante_cpf")
  ajudanteTelefone  String?        @map("ajudante_telefone")
  ajudanteRg        String?        @map("ajudante_rg")
  dataEntrada       DateTime       @map("data_entrada")
  horaEntrada       DateTime?      @map("hora_entrada")
  lacreImageUrl     String?        @map("lacre_image_url")
  fotoCarroceriaUrl String?        @map("foto_carroceria_url")
  obsOcorrencia     String?        @map("obs_ocorrencia")
  obsAnexos         Json           @default("[]") @map("obs_anexos")
  horaSaida         DateTime?      @map("hora_saida")
  setorDestino      String?        @map("setor_destino")
  falarCom          String?        @map("falar_com")
  autorizadoPor     String?        @map("autorizado_por")
  fotoUrl           String?        @map("foto_url")
  fotoThumbUrl      String?        @map("foto_thumb_url")
  status            StatusRegistro @default(na_fila)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  portaria        Portaria @relation(fields: [portariaId], references: [id])
  operadorEntrada User     @relation("OperadorEntrada", fields: [operadorEntradaId], references: [id])
  operadorSaida   User?    @relation("OperadorSaida", fields: [operadorSaidaId], references: [id])
  @@index([protocolo])
  @@index([placa])
  @@index([status])
  @@map("registros")
}

model Ocorrencia {
  id              String           @id @default(uuid())
  protocolo       String           @unique
  categoria       String
  tipo            String
  local           String
  dataHora        DateTime         @map("data_hora")
  descricao       String
  envolvidos      Json             @default("[]")
  testemunhas     Json             @default("[]")
  acionamentos    Json             @default("[]")
  danosMateriais  String?          @map("danos_materiais")
  estimativaDanos Decimal?         @db.Decimal(12, 2) @map("estimativa_danos")
  anexos          Json             @default("[]")
  providencias    String?
  status          StatusOcorrencia @default(aberta)
  registradoPorId String           @map("registrado_por_id")
  registradoPor   User             @relation(fields: [registradoPorId], references: [id])
  criadoEm        DateTime         @default(now()) @map("criado_em")
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em")
  @@index([status])
  @@index([categoria])
  @@index([dataHora])
  @@map("ocorrencias")
}

model Webhook {
  id        String   @id @default(uuid())
  nome      String
  url       String
  eventos   String[]
  ativo     Boolean  @default(true)
  secret    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  @@map("webhooks")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  detalhes   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([acao])
  @@index([createdAt])
  @@map("audit_logs")
}

model Configuracao {
  id        String   @id @default(uuid())
  chave     String   @unique
  valor     String?
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("configuracoes")
}

model ContatoNotificacao {
  id        String   @id @default(uuid())
  nome      String
  telefone  String
  eventos   String[]
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([ativo])
  @@map("contatos_notificacao")
}

model NotificacaoSetor {
  id            String   @id @default(uuid())
  nome          String
  telefone      String
  email         String?
  criterioTipo  String   @map("criterio_tipo")
  criterioValor String   @map("criterio_valor")
  eventos       String[]
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@map("notificacoes_setor")
}

model ApiKey {
  id          String   @id @default(uuid())
  nome        String
  chave       String   @unique
  descricao   String?
  escopos     String[]
  ativo       Boolean  @default(true)
  ultimoUso   DateTime? @map("ultimo_uso")
  criadoPorId String   @map("criado_por_id")
  criadoPor   User     @relation(fields: [criadoPorId], references: [id])
  criadoEm   DateTime  @default(now()) @map("criado_em")
  @@map("api_keys")
}

enum AgendamentoStatus {
  AGUARDANDO_NF
  NF_RECEBIDA
  APROVADO
  NA_PORTARIA
  CONCLUIDO
  CANCELADO
}

model Agendamento {
  id              String            @id @default(uuid())
  token           String            @unique @default(uuid())
  tokenExpiraEm   DateTime          @map("token_expira_em")
  status          AgendamentoStatus @default(AGUARDANDO_NF)

  criadoPorId     String            @map("criado_por_id")
  criadoPor       User              @relation("AgendamentoCriador", fields: [criadoPorId], references: [id])
  departamento    String
  pedidoInterno   String?           @map("pedido_interno")

  empresa         String?
  cnpj            String?
  motorista       String?
  cpfMotorista    String?           @map("cpf_motorista")
  placa           String?
  tipoVeiculo     String?           @map("tipo_veiculo")
  numeroNF        String?           @map("numero_nf")
  valorNF         Decimal?          @map("valor_nf") @db.Decimal(15, 2)
  nfArquivoUrl    String?           @map("nf_arquivo_url")
  dataEntrega     DateTime?         @map("data_entrega")
  horarioPref     String?           @map("horario_pref")
  observacoes     String?

  aprovadoPorId   String?           @map("aprovado_por_id")
  aprovadoPor     User?             @relation("AgendamentoAprovador", fields: [aprovadoPorId], references: [id])
  aprovadoEm      DateTime?         @map("aprovado_em")
  chegadaEm       DateTime?         @map("chegada_em")
  registroId      String?           @map("registro_id")

  portariaId      String            @map("portaria_id")
  portaria        Portaria          @relation(fields: [portariaId], references: [id])

  empresaId       String?           @map("empresa_id")
  empresaCad      Empresa?          @relation("AgendamentoEmpresaId", fields: [empresaId], references: [id])

  criadoEm        DateTime          @default(now()) @map("criado_em")
  atualizadoEm    DateTime          @updatedAt @map("atualizado_em")

  @@index([status])
  @@index([token])
  @@index([criadoPorId])
  @@map("agendamentos")
}

model Empresa {
  id          String   @id @default(uuid())
  nome        String
  cnpj        String?
  email       String
  whatsapp    String
  contato     String?
  observacoes String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  agendamentos Agendamento[] @relation("AgendamentoEmpresaId")

  @@map("empresas")
}

model VideoUniversidade {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String?
  categoria   String   @default("Geral")
  videoUrl    String   @map("video_url")
  thumbUrl    String?  @map("thumb_url")
  destaque    Boolean  @default(false)
  ordem       Int      @default(0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  criadoPorId String?  @map("criado_por_id")
  criadoPor   User?    @relation(fields: [criadoPorId], references: [id])
  @@map("videos_universidade")
}
